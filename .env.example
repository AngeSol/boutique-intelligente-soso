# Copie ce fichier en .env puis remplis tes valeurs (ne jamais committer .env)

# ---------- LLM (RodiumAI, compatible OpenAI)
RODIUM_API_KEY=rd_sk_ta_cle_ici
RODIUM_BASE_URL=https://api.rodiumai.io/v1
LLM_MODEL=openai/gpt-4o-mini
MAX_STEPS=8

# ---------- Palier 2 : évaluation et comparaison
JUGE_ACTIF=1
# Modèle du juge (vide = même modèle que LLM_MODEL)
JUGE_MODEL=
# Prix du modèle en USD par million de tokens (regarde sur rodiumai.io/models), pour estimer le coût
PRIX_ENTREE_1M_USD=0.15
PRIX_SORTIE_1M_USD=0.60
# Conversion des coûts en crédits RodiumAI (catalogue RodiumAI : 2,50 $ = 1 894 RODI, soit ~757,6 RODI par $)
RODI_PAR_USD=757.6

# ---------- Palier 3 : WhatsApp (Green API) — pour le simulateur local
GREEN_API_URL=https://api.green-api.com
GREEN_ID_INSTANCE=
GREEN_API_TOKEN=
# Numéro WhatsApp de la gérante au format Green API : 22997000000@c.us
GERANTE_CHAT_ID=
WEBHOOK_TOKEN=un_long_secret_aleatoire